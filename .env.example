# ═══════════════════════════════════════════════════════════════════════════════
# Janus — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and edit.  All values below are optional with sane
# defaults — the only thing you MUST set is JANUS_MODEL_PATH.

# ── Inference ─────────────────────────────────────────────────────────────────
# Backend: vulkan (default, GPU), cpu, or ollama (HTTP fallback)
INFERENCE_BACKEND=vulkan

# Path to .gguf model — REQUIRED for local inference
JANUS_MODEL_PATH=./models/Llama-3.2-3B-Instruct.Q8_0.gguf

# Path to llama.dll / libllama.so (auto-detected next to janus.exe if blank)
# JANUS_LIB_PATH=

# GPU layers: -1 = all (default, let DLL decide), 0 = CPU only
JANUS_GPU_LAYERS=-1

# Janus VRAM budget in MiB (internal ceiling, not physical VRAM size)
# 9728 = 9.5 GiB, 10752 = 10.5 GiB
# JANUS_VRAM_CEILING_MB=9728

# Max tokens per generation (0 = backend default)
JANUS_MAX_TOKENS=512

# Prompt template: chatml (default), llama2, alpaca
JANUS_PROMPT_FORMAT=chatml

# ── Ollama fallback (only used when INFERENCE_BACKEND=ollama) ────────────────
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=mistral:7b

# ── Per-agent model overrides (Ollama names or .gguf paths) ──────────────────
# PLANNER_MODEL=hf.co/TheBloke/WhiteRabbitNeo-13B-GGUF:q4_k_m
# WORKER_MODEL=
# REVIEWER_MODEL=
# PRUNER_MODEL=

# ── Timeouts ──────────────────────────────────────────────────────────────────
# Planner phase timeout in seconds (default 90)
# PLANNER_TIMEOUT_SECONDS=90

# Execute phase timeout in seconds (default 180)
# EXECUTE_TIMEOUT_SECONDS=180

# ── Cloud routing (Professional / Enterprise license only) ────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# ── Security ──────────────────────────────────────────────────────────────────
# Block all shell execution via run_script (recommended for production)
# JANUS_SAFE_MODE=true

# ── Authentication ────────────────────────────────────────────────────────────
# Set to true to enable Basic Auth on admin endpoints
JANUS_AUTH=true

# Seed admin password (auto-generated and printed to console if blank)
# JANUS_ADMIN_PASSWORD=

# ── Swarm ─────────────────────────────────────────────────────────────────────
# Judge confidence threshold for swarm pass/fail (0.0–1.0, default 0.85)
# SWARM_CONFIDENCE=0.85

# Max worker retries on reviewer fail (default 2)
# SWARM_MAX_RETRIES=2

# ── Updates ───────────────────────────────────────────────────────────────────
# GitHub owner/repo to check for new releases (disabled if blank)
# JANUS_UPDATE_REPO=yourname/janus

# ── Browser ───────────────────────────────────────────────────────────────────
# Set to any value to suppress auto-opening the browser on startup
# JANUS_NO_BROWSER=1


# ── Debug ─────────────────────────────────────────────────────────────────────
# Set to any value to enable verbose agent/planner logging
# DEBUG_PLANNER=1
# DEBUG_AGENT=1
