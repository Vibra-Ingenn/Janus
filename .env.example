# ═══════════════════════════════════════════════════════════════════════════════
# Janus (OSS) — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and edit.
#
# Required for local GGUF inference: JANUS_MODEL_PATH
# Never commit .env — it may contain API keys or passwords.

# ── Local inference ───────────────────────────────────────────────────────────
# Backend: vulkan (GPU), cpu, openrouter, or ollama
INFERENCE_BACKEND=vulkan

# Path to your .gguf model file
JANUS_MODEL_PATH=./models/your-model.Q8_0.gguf

# llama.dll path (auto-detected next to janus.exe if blank)
# JANUS_LIB_PATH=

# GPU layers: -1 = all on GPU, 0 = CPU only
# JANUS_GPU_LAYERS=-1

# Internal VRAM budget in MiB (not your physical VRAM size)
# JANUS_VRAM_CEILING_MB=9216

# Context window size in tokens
# JANUS_CTX_SIZE=4096

# Max tokens per reply
# JANUS_MAX_TOKENS=4096

# Prompt template: chatml, llama2, alpaca
# JANUS_PROMPT_FORMAT=chatml

# ── Ollama (only when INFERENCE_BACKEND=ollama) ───────────────────────────────
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=mistral:7b

# ── Optional cloud routing (leave blank for 100% local) ───────────────────────
# Prefer local models when true
# JANUS_LOCAL_ONLY=true

# OpenRouter — used when model name starts with openrouter/ or backend is openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Google Gemini — used when model name starts with gemini/
# GEMINI_API_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
# JANUS_LISTEN_ADDR=127.0.0.1:8990
# JANUS_NO_BROWSER=1
# JANUS_UPDATE_REPO=yourname/janus

# ── Security ──────────────────────────────────────────────────────────────────
# Block shell commands in the run_command tool
# JANUS_SAFE_MODE=true

# Basic auth on admin routes (Config, model load, etc.)
JANUS_AUTH=false

# Set before first run if JANUS_AUTH=true (otherwise auto-generated once)
# JANUS_ADMIN_PASSWORD=

# ── Kernel (single tool loop — not multi-agent swarm) ─────────────────────────
# yolo = auto-run tools, safe = prompt before destructive tools
# JANUS_EXECUTION_MODE=yolo

# ── modelget downloader only (not read by janus.exe) ────────────────────────
# HF_TOKEN=
