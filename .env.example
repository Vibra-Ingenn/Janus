# ═══════════════════════════════════════════════════════════════════════════════
# Janus (OSS) — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and edit.
#
# Required for local GGUF inference: JANUS_MODEL_PATH
# Never commit .env — it may contain API keys or passwords.

# ── Local inference ───────────────────────────────────────────────────────────
# Backend: vulkan (GPU), cpu, or openrouter
INFERENCE_BACKEND=vulkan

# Path to your .gguf model file
JANUS_MODEL_PATH=./models/your-model.Q8_0.gguf

# llama.dll path (auto-detected next to janus.exe if blank)
# JANUS_LIB_PATH=

# GPU layers: -1 = all on GPU, 0 = CPU only
# JANUS_GPU_LAYERS=-1

# Internal VRAM budget in MiB (not your physical VRAM size)
# JANUS_VRAM_CEILING_MB=9216

# Context window size in tokens
# JANUS_CTX_SIZE=4096

# Max tokens per reply
# JANUS_MAX_TOKENS=4096

# Prompt template: chatml, llama2, alpaca (auto-detected from GGUF if blank)
# JANUS_PROMPT_FORMAT=

# ── OpenRouter (only when INFERENCE_BACKEND=openrouter) ───────────────────────
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Server ────────────────────────────────────────────────────────────────────
# JANUS_LISTEN_ADDR=127.0.0.1:8990
# JANUS_NO_BROWSER=1
# JANUS_UPDATE_REPO=Vibra-Ingenn/Janus

# ── Thinking models ──────────────────────────────────────────────────────────
# Set false to suppress <think> reasoning output
# JANUS_THINK=true

# ── Repetition penalty ────────────────────────────────────────────────────────
# JANUS_REPEAT_PENALTY=1.1
# JANUS_REPEAT_LAST_N=64

# ── modelget downloader only (not read by janus.exe) ────────────────────────
# HF_TOKEN=
