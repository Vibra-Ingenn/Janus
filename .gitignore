workspace/
logs/
*.log
outputs/
outputs/**

# OP-era runtime DB (not shipped in public Janus)
**/community_tools.db

# Runtime routing config (generated beside binary; may contain local paths)
backend_config.json

# Runtime model settings beside the binary (may contain local paths)
cmd/janus/data/model-settings.json
janus_settings.json
**/janus_settings.json


